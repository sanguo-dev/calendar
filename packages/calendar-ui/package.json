{
  "name": "@sanguo-dev/calendar-ui",
  "version": "0.3.0",
  "description": "纯 DOM、零依赖的公历日历核心，支持范围选择、折叠、主题和适配器",
  "keywords": [
    "calendar",
    "datepicker",
    "dom",
    "range",
    "solid"
  ],
  "homepage": "https://github.com/sanguo-dev/calendar/tree/master/packages/calendar-ui#readme",
  "bugs": {
    "url": "https://github.com/sanguo-dev/calendar/issues"
  },
  "license": "MIT",
  "author": "sanguogege@outlook.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanguo-dev/calendar.git",
    "directory": "packages/calendar-ui"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./src/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jsdom": "^25.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
